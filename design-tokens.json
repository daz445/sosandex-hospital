{
  "meta": {
    "name": "Муниципальная городская больница",
    "version": "1.0.0",
    "description": "Design tokens for a Municipal City Hospital management system — appointment booking, doctor schedules, admin panel.",
    "stack": "HTML + CSS + JS (vanilla), FastAPI, SQLite"
  },
  "color": {
    "primary": {
      "50":  "#EFF6FF",
      "100": "#DBEAFE",
      "200": "#BFDBFE",
      "300": "#93C5FD",
      "400": "#60A5FA",
      "500": "#3B82F6",
      "600": "#2563EB",
      "700": "#1D4ED8",
      "800": "#1E40AF",
      "900": "#1E3A8A",
      "950": "#172554"
    },
    "secondary": {
      "50":  "#F0FDFA",
      "100": "#CCFBF1",
      "200": "#99F6E4",
      "300": "#5EEAD4",
      "400": "#2DD4BF",
      "500": "#14B8A6",
      "600": "#0D9488",
      "700": "#0F766E",
      "800": "#115E59",
      "900": "#134E4A",
      "950": "#042F2E"
    },
    "accent": {
      "50":  "#F0FDF4",
      "100": "#DCFCE7",
      "200": "#BBF7D0",
      "300": "#86EFAC",
      "400": "#4ADE80",
      "500": "#22C55E",
      "600": "#16A34A",
      "700": "#15803D",
      "800": "#166534",
      "900": "#14532D"
    },
    "warning": {
      "50":  "#FFFBEB",
      "100": "#FEF3C7",
      "200": "#FDE68A",
      "300": "#FCD34D",
      "400": "#FBBF24",
      "500": "#F59E0B",
      "600": "#D97706",
      "700": "#B45309",
      "800": "#92400E",
      "900": "#78350F"
    },
    "danger": {
      "50":  "#FEF2F2",
      "100": "#FEE2E2",
      "200": "#FECACA",
      "300": "#FCA5A5",
      "400": "#F87171",
      "500": "#EF4444",
      "600": "#DC2626",
      "700": "#B91C1C",
      "800": "#991B1B",
      "900": "#7F1D1D"
    },
    "neutral": {
      "0":   "#FFFFFF",
      "50":  "#F8FAFC",
      "100": "#F1F5F9",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A",
      "950": "#020617"
    },
    "semantic": {
      "bg-page":         "#F1F5F9",
      "bg-surface":      "#FFFFFF",
      "bg-surface-alt":  "#F8FAFC",
      "bg-overlay":      "rgba(15, 23, 42, 0.5)",
      "text-primary":    "#0F172A",
      "text-secondary":  "#475569",
      "text-muted":      "#94A3B8",
      "text-inverse":    "#FFFFFF",
      "border-default":  "#E2E8F0",
      "border-strong":   "#CBD5E1",
      "border-focus":    "#3B82F6",
      "status-booked":    "#3B82F6",
      "status-available": "#22C55E",
      "status-cancelled": "#EF4444",
      "status-pending":   "#F59E0B"
    }
  },
  "typography": {
    "font-family": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans', 'Ubuntu', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "display": { "size": "2.25rem", "weight": 700, "line-height": 1.2, "tracking": "-0.025em" },
      "h1":      { "size": "1.875rem","weight": 700, "line-height": 1.25,"tracking": "-0.025em" },
      "h2":      { "size": "1.5rem",  "weight": 600, "line-height": 1.3  },
      "h3":      { "size": "1.25rem", "weight": 600, "line-height": 1.375 },
      "h4":      { "size": "1.125rem","weight": 600, "line-height": 1.375 },
      "body-lg": { "size": "1.125rem","weight": 400, "line-height": 1.625 },
      "body":    { "size": "1rem",    "weight": 400, "line-height": 1.5  },
      "body-sm": { "size": "0.875rem","weight": 400, "line-height": 1.5  },
      "caption": { "size": "0.75rem", "weight": 500, "line-height": 1.5  },
      "label":   { "size": "0.875rem","weight": 500, "line-height": 1.5  },
      "data":    { "size": "1rem",    "weight": 600, "line-height": 1.5  }
    }
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0", "px": "1px", "0.5": "2px", "1": "4px", "1.5": "6px",
      "2": "8px", "2.5": "10px", "3": "12px", "3.5": "14px", "4": "16px",
      "5": "20px", "6": "24px", "7": "28px", "8": "32px", "9": "36px",
      "10": "40px", "12": "48px", "14": "56px", "16": "64px", "20": "80px",
      "24": "96px"
    },
    "semantic": {
      "page-padding":       "24px",
      "card-padding":       "20px",
      "card-gap":           "16px",
      "section-gap":        "32px",
      "input-padding-x":    "12px",
      "input-padding-y":    "8px",
      "button-padding-x":   "16px",
      "button-padding-y":   "8px",
      "table-cell-padding": "12px",
      "sidebar-width":      "256px",
      "header-height":      "64px",
      "modal-max-width":    "512px"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "2xl": "16px", "full": "9999px"
  },
  "shadow": {
    "xs":   "0 1px 2px 0 rgba(0,0,0,0.05)",
    "sm":   "0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1)",
    "md":   "0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1)",
    "lg":   "0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1)",
    "xl":   "0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1)",
    "inner": "inset 0 2px 4px 0 rgba(0,0,0,0.05)",
    "focus": "0 0 0 3px rgba(59,130,246,0.3)"
  },
  "breakpoint": {
    "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px"
  },
  "transition": {
    "fast": "150ms ease", "normal": "200ms ease", "slow": "300ms ease"
  },
  "z-index": {
    "dropdown": 10, "sticky": 20, "overlay": 30, "modal": 40, "toast": 50
  }
}
